<?xml version="1.0" encoding="UTF-8"?>
<jasperReport
        xmlns="http://jasperreports.sourceforge.net/jasperreports"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports
                        http://jasperreports.sourceforge.net/xsd/jasperreport.xsd"
        name="CompetencesSubreport"
        pageWidth="535"
        pageHeight="60"
        columnWidth="535"
        leftMargin="0"
        rightMargin="0"
        topMargin="0"
        bottomMargin="0">

    <!-- Define fields -->
    <field name="nom" class="java.lang.String"/>
    <field name="competenceNiveau" class="java.lang.String"/>

    <detail>
        <band height="20" splitType="Stretch">
            <!-- Display competence name and level together -->
            <textField textAdjust="StretchHeight">
                <reportElement x="10" y="0" width="525" height="20"/>
                <textFieldExpression><![CDATA[$F{nom} + " : " + $F{competenceNiveau}]]></textFieldExpression>
            </textField>
        </band>
    </detail>
</jasperReport>
