<?xml version="1.0" encoding="UTF-8"?>
<jasperReport
        xmlns="http://jasperreports.sourceforge.net/jasperreports"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd"
        name="FormationsSubreport"
        pageWidth="535"
        pageHeight="80"
        columnWidth="535"
        leftMargin="0"
        rightMargin="0"
        topMargin="0"
        bottomMargin="0"
        whenNoDataType="AllSectionsNoDetail">

    <field name="diplome" class="java.lang.String"/>
    <field name="universite" class="java.lang.String"/>
    <field name="dateDebut" class="java.time.LocalDate"/>
    <field name="dateFin" class="java.time.LocalDate"/>

    <detail>
        <band height="40" splitType="Stretch">
            <textField>
                <reportElement x="0" y="0" width="350" height="20"/>
                <textElement>
                    <font isBold="true"/>
                </textElement>
                <textFieldExpression><![CDATA[$F{diplome} + " - " + $F{universite}]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement x="0" y="20" width="350" height="20"/>
                <textFieldExpression><![CDATA[($F{dateDebut} != null ? $F{dateDebut}.toString() : "") + " - " + ($F{dateFin} != null ? $F{dateFin}.toString() : "")]]></textFieldExpression>
            </textField>
        </band>
    </detail>
</jasperReport>
