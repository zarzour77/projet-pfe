<?xml version="1.0" encoding="UTF-8"?>
<jasperReport
        xmlns="http://jasperreports.sourceforge.net/jasperreports"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports
                        http://jasperreports.sourceforge.net/xsd/jasperreport.xsd"
        name="SimpleCVReport"
        pageWidth="595"
        pageHeight="842"
        columnWidth="535"
        leftMargin="30"
        rightMargin="30"
        topMargin="20"
        bottomMargin="20">

    <!-- Define reusable styles using SansSerif instead of Helvetica -->
    <style name="HeaderStyle" fontSize="18" isBold="true" />
    <style name="SubHeaderStyle" fontSize="14" isBold="true" />
    <style name="InfoStyle" fontSize="12" />

    <!-- PARAMETERS -->
    <parameter name="nom" class="java.lang.String"/>
    <parameter name="prenom" class="java.lang.String"/>
    <parameter name="email" class="java.lang.String"/>
    <parameter name="telephone" class="java.lang.String"/>
    <parameter name="experienceYears" class="java.lang.Integer"/>
    <parameter name="adresse" class="java.lang.String"/>
    <parameter name="experienceDataSource" class="net.sf.jasperreports.engine.JRDataSource"/>
    <parameter name="experienceSubreport" class="net.sf.jasperreports.engine.JasperReport"/>
    <parameter name="competenceDataSource" class="net.sf.jasperreports.engine.JRDataSource"/>
    <parameter name="competenceSubreport" class="net.sf.jasperreports.engine.JasperReport"/>
    <parameter name="domainesDataSource" class="net.sf.jasperreports.engine.JRDataSource"/>
    <parameter name="domainesSubreport" class="net.sf.jasperreports.engine.JasperReport"/>
    <parameter name="formationsDataSource" class="net.sf.jasperreports.engine.JRDataSource"/>
    <parameter name="formationsSubreport" class="net.sf.jasperreports.engine.JasperReport"/>
    <parameter name="certificationsDataSource" class="net.sf.jasperreports.engine.JRDataSource"/>
    <parameter name="certificationsSubreport" class="net.sf.jasperreports.engine.JasperReport"/>
    <parameter name="languesDataSource" class="net.sf.jasperreports.engine.JRDataSource"/>
    <parameter name="languesSubreport" class="net.sf.jasperreports.engine.JasperReport"/>

    <!-- TITLE SECTION -->
    <title>
        <!-- Reduced band height to 90 to remove extra white space -->
        <band height="90">
            <!-- Consultant Name (big and bold, centered) -->
            <textField>
                <reportElement x="0" y="10" width="535" height="30" style="HeaderStyle"/>
                <textElement textAlignment="Center" verticalAlignment="Middle"/>
                <textFieldExpression><![CDATA[$P{prenom} + " " + $P{nom}]]></textFieldExpression>
            </textField>
            <!-- Domaines subreport: lists the consultant's domaines -->
            <subreport>
                <reportElement x="0" y="45" width="535" height="40"/>
                <dataSourceExpression><![CDATA[$P{domainesDataSource}]]></dataSourceExpression>
                <subreportExpression><![CDATA[$P{domainesSubreport}]]></subreportExpression>
            </subreport>
        </band>
    </title>

    <!-- DETAIL SECTION -->
    <!-- Increased band height to accommodate all sections -->
    <detail>
        <band splitType="Stretch" height="700">
            <!-- CONTACT SECTION -->
            <staticText>
                <reportElement x="0" y="0" width="535" height="20" style="SubHeaderStyle"/>
                <text><![CDATA[Informations personnelles]]></text>
            </staticText>
            <textField textAdjust="StretchHeight">
                <reportElement x="10" y="25" width="535" height="20" style="InfoStyle" positionType="Float"/>
                <textFieldExpression><![CDATA["Téléphone : " + $P{telephone}]]></textFieldExpression>
            </textField>
            <textField textAdjust="StretchHeight">
                <reportElement x="10" y="50" width="535" height="20" style="InfoStyle" positionType="Float"/>
                <textFieldExpression><![CDATA["Email : " + $P{email}]]></textFieldExpression>
            </textField>
            <textField textAdjust="StretchHeight">
                <reportElement x="10" y="75" width="535" height="20" style="InfoStyle" positionType="Float"/>
                <textFieldExpression><![CDATA["Adresse : " + $P{adresse}]]></textFieldExpression>
            </textField>

            <!-- EXPERIENCES SECTION -->
            <staticText>
                <reportElement x="0" y="105" width="535" height="20" style="SubHeaderStyle" positionType="Float"/>
                <text><![CDATA[Expériences Professionnelles]]></text>
            </staticText>
            <subreport>
                <reportElement x="10" y="130" width="535" height="70" positionType="Float"/>
                <dataSourceExpression><![CDATA[$P{experienceDataSource}]]></dataSourceExpression>
                <subreportExpression><![CDATA[$P{experienceSubreport}]]></subreportExpression>
            </subreport>

            <!-- COMPETENCES SECTION -->
            <staticText>
                <reportElement x="0" y="210" width="535" height="20" style="SubHeaderStyle" positionType="Float"/>
                <text><![CDATA[Compétences]]></text>
            </staticText>
            <subreport>
                <reportElement x="10" y="235" width="535" height="70" positionType="Float"/>
                <dataSourceExpression><![CDATA[$P{competenceDataSource}]]></dataSourceExpression>
                <subreportExpression><![CDATA[$P{competenceSubreport}]]></subreportExpression>
            </subreport>

            <!-- LANGUES SECTION -->
            <staticText>
                <reportElement x="0" y="315" width="535" height="20" style="SubHeaderStyle" positionType="Float"/>
                <text><![CDATA[Langues]]></text>
            </staticText>
            <subreport>
                <reportElement x="10" y="340" width="535" height="70" positionType="Float"/>
                <dataSourceExpression><![CDATA[$P{languesDataSource}]]></dataSourceExpression>
                <subreportExpression><![CDATA[$P{languesSubreport}]]></subreportExpression>
            </subreport>

            <!-- FORMATIONS SECTION -->
            <staticText>
                <reportElement x="0" y="420" width="535" height="20" style="SubHeaderStyle" positionType="Float"/>
                <text><![CDATA[Formations]]></text>
            </staticText>
            <subreport>
                <reportElement x="10" y="445" width="535" height="70" positionType="Float"/>
                <dataSourceExpression><![CDATA[$P{formationsDataSource}]]></dataSourceExpression>
                <subreportExpression><![CDATA[$P{formationsSubreport}]]></subreportExpression>
            </subreport>

            <!-- CERTIFICATIONS SECTION -->
            <staticText>
                <reportElement x="0" y="525" width="535" height="20" style="SubHeaderStyle" positionType="Float"/>
                <text><![CDATA[Certifications]]></text>
            </staticText>
            <subreport>
                <reportElement x="10" y="550" width="535" height="70" positionType="Float"/>
                <dataSourceExpression><![CDATA[$P{certificationsDataSource}]]></dataSourceExpression>
                <subreportExpression><![CDATA[$P{certificationsSubreport}]]></subreportExpression>
            </subreport>
        </band>
    </detail>

</jasperReport>
